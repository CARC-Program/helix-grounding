dist/
build/
*.egg-info/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and generated output
*.sqlite
*.sqlite3
*.db
diagram_output/

# OS
Thumbs.db
desktop.ini
.DS_Store
